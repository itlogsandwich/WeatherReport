<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WeatherReport.Pages.WeatherPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WeatherReport.Controls"
    xmlns:vm="clr-namespace:WeatherReport.ViewModels"
    x:DataType="vm:WeatherViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*">

        <controls:TopAppBar Grid.Row="0" Title="WeatherReport" />

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,32" Spacing="20">

                    <!-- ─── HERO: Location + Temperature ─────────────────────────── -->
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="📍" FontSize="15" VerticalOptions="Center"
                                   TextColor="{DynamicResource Primary}" />
                            <Label FontSize="17" FontAttributes="Bold"
                                   TextColor="{DynamicResource OnSurface}"
                                   VerticalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0}, {1}">
                                        <Binding Path="City" />
                                        <Binding Path="Country" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </HorizontalStackLayout>

                        <Label Text="{Binding TempDisplay}"
                               FontSize="88"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Primary}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,8,0,0" />

                        <Label Text="{Binding Icon}" FontSize="52"
                               HorizontalOptions="Center"
                               Margin="0,-8,0,0" />

                        <Label Text="{Binding Condition}"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{DynamicResource OnSurface}"
                               HorizontalOptions="Center" />

                        <Label Text="{Binding HiLoFeelsDisplay}"
                               FontSize="13"
                               TextColor="{DynamicResource OnSurfaceVariant}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,2,0,0" />

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmptyConverter}}"
                               FontSize="12"
                               TextColor="#C84B4B"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <!-- ─── METRIC CARDS ──────────────────────────────────────────── -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                        <Border Grid.Column="0" Style="{DynamicResource MetricCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="💧" FontSize="22" />
                                <Label Text="HUMIDITY" FontSize="10" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="{Binding HumidityDisplay}" FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="{Binding DewPointDisplay}" FontSize="10"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{DynamicResource MetricCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="🌬️" FontSize="22" />
                                <Label Text="WIND" FontSize="10" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="{Binding WindDisplay}" FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="{Binding WindDetailDisplay}" FontSize="10"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" Style="{DynamicResource MetricCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="🌡️" FontSize="22" />
                                <Label Text="UV INDEX" FontSize="10" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="{Binding UvDisplay}" FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="{Binding UvAdviceDisplay}" FontSize="10"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- ─── 5-DAY FORECAST ────────────────────────────────────────── -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="5-Day Forecast"
                               Style="{DynamicResource SectionTitleStyle}" />

                        <Border Style="{DynamicResource CardStyle}" Padding="0">
                            <CollectionView ItemsSource="{Binding Forecast}"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ForecastDayViewModel">
                                        <Grid Padding="20,15"
                                              ColumnDefinitions="*,Auto,Auto,Auto">
                                            <Label Grid.Column="0" Text="{Binding DayName}"
                                                   FontAttributes="Bold" FontSize="15"
                                                   TextColor="{DynamicResource OnSurface}"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding Icon}" FontSize="20"
                                                   VerticalOptions="Center" Margin="0,0,14,0"/>
                                            <Label Grid.Column="2" Text="{Binding HighDisplay}"
                                                   FontAttributes="Bold" FontSize="15"
                                                   TextColor="{DynamicResource OnSurface}"
                                                   VerticalOptions="Center" Margin="0,0,10,0"/>
                                            <Label Grid.Column="3" Text="{Binding LowDisplay}" FontSize="14"
                                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Precipitation map (Cebu island) -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Precipitation Map"
                               Style="{DynamicResource SectionTitleStyle}" />

                        <Border StrokeThickness="0" Stroke="Transparent"
                                StrokeShape="RoundRectangle 16"
                                HeightRequest="250"
                                Padding="0">
                            <Grid>
                                <Image Source="cebu_precipitation_map.png"
                                       Aspect="AspectFit"
                                       BackgroundColor="#BFE6F2" />
                                <BoxView BackgroundColor="#0B2433"
                                         Opacity="0.24" />

                                <Grid Padding="16"
                                      RowDefinitions="Auto,*,Auto">
                                    <VerticalStackLayout Grid.Row="0" Spacing="4">
                                        <Label Text="PRECIPITATION MAP"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#E9FAFF" />
                                        <Label Text="Cebu Island"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                        <Label Text="{Binding PrecipitationDetailDisplay}"
                                               FontSize="11"
                                               TextColor="#D4F6FF" />
                                    </VerticalStackLayout>

                                    <Grid Grid.Row="2"
                                          ColumnDefinitions="*,*,*"
                                          ColumnSpacing="8">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#D9153240"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="10,8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="NOW"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="#BFEFFF" />
                                                <Label Text="{Binding PrecipitationDisplay}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Column="1"
                                                BackgroundColor="#D9153240"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="10,8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="CHANCE"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="#BFEFFF" />
                                                <Label Text="{Binding PrecipitationProbabilityDisplay}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Column="2"
                                                BackgroundColor="#D9153240"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="10,8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="TODAY"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="#BFEFFF" />
                                                <Label Text="{Binding DailyPrecipitationDisplay}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
