<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WeatherReport.Pages.WeatherPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WeatherReport.Controls"
    xmlns:vm="clr-namespace:WeatherReport.ViewModels"
    x:DataType="vm:WeatherViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*">

        <controls:TopAppBar Grid.Row="0" Title="WeatherReport" />

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,32" Spacing="20">

                    <!-- ─── HERO: Location + Temperature ─────────────────────────── -->
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="📍" FontSize="15" VerticalOptions="Center"
                                   TextColor="{DynamicResource Primary}" />
                            <Label FontSize="17" FontAttributes="Bold"
                                   TextColor="{DynamicResource OnSurface}"
                                   VerticalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0}, {1}">
                                        <Binding Path="City" />
                                        <Binding Path="Country" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </HorizontalStackLayout>

                        <Label Text="{Binding TempDisplay}"
                               FontSize="88"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource Primary}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,8,0,0" />

                        <Label Text="{Binding Icon}" FontSize="52"
                               HorizontalOptions="Center"
                               Margin="0,-8,0,0" />

                        <Label Text="{Binding Condition}"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{DynamicResource OnSurface}"
                               HorizontalOptions="Center" />

                        <Label Text="{Binding HiLoFeelsDisplay}"
                               FontSize="13"
                               TextColor="{DynamicResource OnSurfaceVariant}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,2,0,0" />

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmptyConverter}}"
                               FontSize="12"
                               TextColor="#C84B4B"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <!-- ─── METRIC CARDS ──────────────────────────────────────────── -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                        <Border Grid.Column="0" Style="{DynamicResource MetricCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="💧" FontSize="22" />
                                <Label Text="HUMIDITY" FontSize="10" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="{Binding HumidityDisplay}" FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="{Binding DewPointDisplay}" FontSize="10"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{DynamicResource MetricCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="🌬️" FontSize="22" />
                                <Label Text="WIND" FontSize="10" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="{Binding WindDisplay}" FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="{Binding WindDetailDisplay}" FontSize="10"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" Style="{DynamicResource MetricCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="🌡️" FontSize="22" />
                                <Label Text="UV INDEX" FontSize="10" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                                <Label Text="{Binding UvDisplay}" FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="{Binding UvAdviceDisplay}" FontSize="10"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- ─── 5-DAY FORECAST ────────────────────────────────────────── -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="5-Day Forecast"
                               Style="{DynamicResource SectionTitleStyle}" />

                        <Border Style="{DynamicResource CardStyle}" Padding="0">
                            <CollectionView ItemsSource="{Binding Forecast}"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ForecastDayViewModel">
                                        <Grid Padding="20,15"
                                              ColumnDefinitions="*,Auto,Auto,Auto">
                                            <Label Grid.Column="0" Text="{Binding DayName}"
                                                   FontAttributes="Bold" FontSize="15"
                                                   TextColor="{DynamicResource OnSurface}"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding Icon}" FontSize="20"
                                                   VerticalOptions="Center" Margin="0,0,14,0"/>
                                            <Label Grid.Column="2" Text="{Binding HighDisplay}"
                                                   FontAttributes="Bold" FontSize="15"
                                                   TextColor="{DynamicResource OnSurface}"
                                                   VerticalOptions="Center" Margin="0,0,10,0"/>
                                            <Label Grid.Column="3" Text="{Binding LowDisplay}" FontSize="14"
                                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>

                    <!-- ─── MAP PLACEHOLDER ──────────────────────────────────────── -->
                    <Border StrokeThickness="0" Stroke="Transparent"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="160">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#a9e2ff" Offset="0.0" />
                                <GradientStop Color="#29667e" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Label FontSize="13" FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="🗺️  {0} — Philippines">
                                        <Binding Path="City" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Border BackgroundColor="{DynamicResource Surface}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24"
                                    Padding="12,6"
                                    VerticalOptions="End"
                                    HorizontalOptions="Start"
                                    Margin="16,0,0,14">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="🗺️" FontSize="12" VerticalOptions="Center"/>
                                    <Label Text="PRECIPITATION MAP"
                                           FontSize="10" FontAttributes="Bold"
                                           TextColor="{DynamicResource OnSurface}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
