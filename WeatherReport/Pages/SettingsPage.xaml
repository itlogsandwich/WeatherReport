<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WeatherReport.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*">

        <!-- ══════════════════════════════ TOP APP BAR ══════════════════════════════ -->
        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource Surface}"
                StrokeThickness="0"
                Stroke="Transparent">
            <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0" Text="☰" FontSize="22"
                       TextColor="{DynamicResource PrimaryDim}" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="WeatherReport"
                       FontSize="20" FontAttributes="Bold"
                       TextColor="{DynamicResource OnSurface}"
                       VerticalOptions="Center" Margin="12,0,0,0"/>
                <Label Grid.Column="2" Text="🔍" FontSize="20"
                       TextColor="{DynamicResource PrimaryDim}" VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════ SCROLL BODY ══════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,40" Spacing="16">

                <!-- ─── Page Header ──────────────────────────────────────────── -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Settings"
                           Style="{DynamicResource PageTitleStyle}" />
                    <Label Text="Configure WeatherReport."
                           Style="{DynamicResource SubtitleStyle}" />
                </VerticalStackLayout>

                <!-- ─── Temperature Unit Card ────────────────────────────────── -->
                <Border Style="{DynamicResource CardStyle}">
                    <VerticalStackLayout Spacing="16">

                        <!-- Card header -->
                        <HorizontalStackLayout Spacing="14">
                            <Border BackgroundColor="{DynamicResource SecondaryContainer}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24"
                                    WidthRequest="48" HeightRequest="48">
                                <Label Text="🌡️" FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Temperature Unit"
                                       FontSize="17" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="Choose your preferred scale"
                                       FontSize="12"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Segmented toggle -->
                        <Border BackgroundColor="{DynamicResource SurfaceContainerLow}"
                                StrokeThickness="0"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 32"
                                Padding="4"
                                HeightRequest="52">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">

                                <!-- Celsius button -->
                                <Border x:Name="CelsiusBorder"
                                        Grid.Column="0"
                                        BackgroundColor="{DynamicResource Primary}"
                                        StrokeThickness="0"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 28">
                                    <Label x:Name="CelsiusLabel"
                                           Text="Celsius (°C)"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="{DynamicResource OnPrimary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCelsiusTapped" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <!-- Fahrenheit button -->
                                <Border x:Name="FahrenheitBorder"
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        StrokeThickness="0"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 28">
                                    <Label x:Name="FahrenheitLabel"
                                           Text="Fahrenheit (°F)"
                                           FontSize="14" FontAttributes="Bold"
                                           TextColor="{DynamicResource OnSurfaceVariant}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFahrenheitTapped" />
                                    </Border.GestureRecognizers>
                                </Border>

                            </Grid>
                        </Border>

                        <!-- Live preview -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="Preview:" FontSize="13"
                                   TextColor="{DynamicResource OnSurfaceVariant}" />
                            <Label x:Name="PreviewLabel"
                                   Text="33°C"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ─── Other Settings List ───────────────────────────────────── -->
                <Border Style="{DynamicResource CardStyle}" Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Notifications -->
                        <Grid Padding="20,16" ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="🔔" FontSize="22" VerticalOptions="Center" Margin="0,0,14,0"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Notification Preferences"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="Alerts, daily summary, severe weather"
                                       FontSize="12"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{DynamicResource OutlineVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" Color="{DynamicResource SurfaceContainerLow}" />

                        <!-- Appearance -->
                        <Grid Padding="20,16" ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="🌙" FontSize="22" VerticalOptions="Center" Margin="0,0,14,0"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Appearance"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label x:Name="AppearanceLabel"
                                       Text="Light mode"
                                       FontSize="12"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Switch x:Name="AppearanceSwitch"
                                    Grid.Column="2"
                                    Toggled="OnAppearanceToggled"
                                    ThumbColor="{DynamicResource Primary}"
                                    OnColor="{DynamicResource PrimaryContainer}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" Color="{DynamicResource SurfaceContainerLow}" />

                        <!-- Saved Locations -->
                        <Grid Padding="20,16" ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="📍" FontSize="22" VerticalOptions="Center" Margin="0,0,14,0"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Saved Locations"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="Manage your tracked cities"
                                       FontSize="12"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{DynamicResource OutlineVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" Color="{DynamicResource SurfaceContainerLow}" />

                        <!-- Language -->
                        <Grid Padding="20,16" ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="🌐" FontSize="22" VerticalOptions="Center" Margin="0,0,14,0"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Language"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource OnSurface}" />
                                <Label Text="English (US)"
                                       FontSize="12"
                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="22"
                                   TextColor="{DynamicResource OutlineVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ─── About / Rate Us ───────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <!-- About card -->
                    <Border Grid.Column="0"
                            BackgroundColor="{DynamicResource PrimaryContainer}"
                            StrokeThickness="0"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 16"
                            Padding="20"
                            MinimumHeightRequest="160">
                        <VerticalStackLayout Spacing="12" VerticalOptions="Fill">
                            <Label Text="ℹ️" FontSize="26"/>
                            <Label Text="About&#10;WeatherReport"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="v1.0.0 (Build 1)&#10;Built for sky-watchers."
                                   FontSize="12"
                                   TextColor="{DynamicResource PrimaryDim}"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="End" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Rate Us card -->
                    <Border Grid.Column="1"
                            StrokeThickness="0"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 16"
                            MinimumHeightRequest="160">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#9bd4f0" Offset="0.0" />
                                <GradientStop Color="#195a72" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout VerticalOptions="End" Padding="16">
                            <Button Text="⭐  Rate Us"
                                    BackgroundColor="{DynamicResource Surface}"
                                    TextColor="{DynamicResource Primary}"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    CornerRadius="24"
                                    Padding="16,10"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- ─── Legal Footer ─────────────────────────────────────────── -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,12,0,0">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="24">
                        <Label Text="Privacy Policy"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Label Text="Terms of Service"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{DynamicResource OnSurfaceVariant}" />
                    </HorizontalStackLayout>
                    <Label Text="© 2026 WeatherReport"
                           FontSize="10" TextColor="{DynamicResource Outline}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
