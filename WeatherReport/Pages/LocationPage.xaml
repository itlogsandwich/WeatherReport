<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WeatherReport.Pages.LocationsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:WeatherReport.Controls"
    xmlns:vm="clr-namespace:WeatherReport.ViewModels"
    x:DataType="vm:LocationsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*">

        <controls:TopAppBar Grid.Row="0" Title="WeatherReport" />

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,32" Spacing="16">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Locations" Style="{DynamicResource PageTitleStyle}" />
                        <Label Text="Saved cities — Philippines" Style="{DynamicResource SubtitleStyle}" />
                    </VerticalStackLayout>

                    <Label Text="SAVED LOCATIONS"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="{DynamicResource Outline}"
                           Margin="2,4,0,0" />

                    <CollectionView ItemsSource="{Binding Cards}"
                                    SelectionMode="None"
                                    ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocationCardViewModel">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Execute">
                                            <SwipeItem Text="Remove"
                                                       BackgroundColor="#C84B4B"
                                                       IsVisible="{Binding IsHome, Converter={StaticResource InvertBoolConverter}}"
                                                       Command="{Binding Source={x:Reference Root}, Path=BindingContext.RemoveCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border StrokeThickness="0"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="20,16"
                                            BackgroundColor="{Binding IsHome, Converter={StaticResource HomeBackgroundConverter}}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                <Label Text="📍 CURRENT LOCATION"
                                                       FontSize="10" FontAttributes="Bold"
                                                       TextColor="{DynamicResource PrimaryDim}"
                                                       IsVisible="{Binding IsHome}" />
                                                <Label FontSize="10" FontAttributes="Bold"
                                                       TextColor="{DynamicResource Outline}"
                                                       IsVisible="{Binding IsHome, Converter={StaticResource InvertBoolConverter}}">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="LOCAL TIME  {0}">
                                                            <Binding Path="LocalTime" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>

                                                <Label Text="{Binding City}"
                                                       FontSize="22" FontAttributes="Bold"
                                                       TextColor="{DynamicResource OnSurface}" />
                                                <Label Text="{Binding Country}"
                                                       FontSize="13"
                                                       TextColor="{DynamicResource OnSurfaceVariant}"
                                                       IsVisible="{Binding IsHome}" />
                                                <Label Text="{Binding Condition}"
                                                       FontSize="13"
                                                       TextColor="{DynamicResource OnSurfaceVariant}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 HorizontalOptions="End"
                                                                 VerticalOptions="Center"
                                                                 Spacing="0">
                                                <Label Text="{Binding Icon}" FontSize="40" HorizontalOptions="End"/>
                                                <Label Text="{Binding TempDisplay}"
                                                       FontSize="30" FontAttributes="Bold"
                                                       TextColor="{DynamicResource Primary}"
                                                       HorizontalOptions="End"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="＋  Add Location"
                            Clicked="OnAddLocationClicked"
                            Style="{DynamicResource GhostButtonStyle}"
                            BorderColor="{DynamicResource OutlineVariant}"
                            BorderWidth="1.5"
                            CornerRadius="14"
                            HeightRequest="52"
                            HorizontalOptions="Fill"
                            Margin="0,4,0,0" />

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullOrEmptyConverter}}"
                           FontSize="12"
                           TextColor="#C84B4B"
                           HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="0" Margin="0,8,0,0">
                        <Label Text="Regional Overview"
                               Style="{DynamicResource SectionTitleStyle}" />

                        <Border StrokeThickness="0" Stroke="Transparent"
                                StrokeShape="RoundRectangle 16"
                                HeightRequest="250"
                                Padding="0">
                            <Grid>
                                <Image Source="philippines_precipitation_map.png"
                                       Aspect="AspectFill" />
                                <BoxView BackgroundColor="#0B2433"
                                         Opacity="0.32" />
                                <VerticalStackLayout Padding="16" Spacing="4"
                                                     VerticalOptions="Start">
                                    <Label Text="LOCATION"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="#E9FAFF" />
                                    <Label Text="Philippine Archipelago"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label FontSize="11"
                                           TextColor="#D4F6FF">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0}, {1}">
                                                <Binding Path="City" />
                                                <Binding Path="Country" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
