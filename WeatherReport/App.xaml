<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:WeatherReport"
             xmlns:conv="clr-namespace:WeatherReport.Converters"
             x:Class="WeatherReport.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:NotNullOrEmptyConverter   x:Key="NotNullOrEmptyConverter" />
            <conv:InvertBoolConverter       x:Key="InvertBoolConverter" />
            <conv:HomeBackgroundConverter   x:Key="HomeBackgroundConverter" />
            <conv:UnitPillBackgroundConverter x:Key="UnitPillBackgroundConverter" />
            <conv:UnitPillTextConverter     x:Key="UnitPillTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
