<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherReport.MainPage"
             BackgroundColor="#F7F9FC"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

       
        <Border Grid.Row="0"
                BackgroundColor="White"
                Stroke="Transparent">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.05"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Padding="12,28,12,10">

                <Border Grid.Column="0"
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        Padding="8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999"/>
                    </Border.StrokeShape>
                    <Label Text="&#9776;"
                           FontSize="22"
                           TextColor="#195A72"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>

                <Label Grid.Column="1"
                       Text="Atmosphere"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#003F53"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       CharacterSpacing="-0.5"/>

                <Border Grid.Column="2"
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        Padding="8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999"/>
                    </Border.StrokeShape>
                    <Label Text="&#128269;"
                           FontSize="20"
                           TextColor="#195A72"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>

            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,24,16,16" Spacing="24">

                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="6"
                                     Padding="0,8">

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Text="&#128205;"
                               FontSize="18"
                               VerticalOptions="Center"/>
                        <Label Text="Cebu, PH"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#2C3338"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="Auto,Auto"
                          HorizontalOptions="Center"
                          ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="31°"
                               FontSize="88"
                               FontAttributes="Bold"
                               TextColor="#29667E"
                               HorizontalOptions="Center"
                               LineBreakMode="NoWrap"/>
                        <Label Grid.Column="1"
                               Text="&#9728;"
                               FontSize="52"
                               VerticalOptions="Center"
                               Margin="0,12,0,0"/>
                    </Grid>

                    <Label Text="Partly Cloudy"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#2C3338"
                           HorizontalOptions="Center"/>

                    <Label Text="H: 33°   L: 26°   •   Feels like 36°"
                           FontSize="13"
                           TextColor="#596065"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                    
                    <Border Grid.Column="0"
                            BackgroundColor="#F0F4F8"
                            Stroke="Transparent"
                            Padding="14,16"
                            MinimumHeightRequest="130">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="&#128167;"
                                   FontSize="18"/>
                            <Label Text="HUMIDITY"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   TextColor="#596065"
                                   CharacterSpacing="1"
                                   Margin="0,2,0,0"/>
                            <Label Text="78%"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#2C3338"
                                   Margin="0,10,0,0"/>
                            <Label Text="Dew point is 25° now"
                                   FontSize="10"
                                   TextColor="#596065"
                                   Margin="0,6,0,0"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                  
                    <Border Grid.Column="1"
                            BackgroundColor="#F0F4F8"
                            Stroke="Transparent"
                            Padding="14,16"
                            MinimumHeightRequest="130">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="&#128168;"
                                   FontSize="18"/>
                            <Label Text="WIND"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   TextColor="#596065"
                                   CharacterSpacing="1"
                                   Margin="0,2,0,0"/>
                            <Label Text="9 mph"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#2C3338"
                                   Margin="0,10,0,0"/>
                            <Label Text="NE gusts up to 14 mph"
                                   FontSize="10"
                                   TextColor="#596065"
                                   Margin="0,6,0,0"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                
                    <Border Grid.Column="2"
                            BackgroundColor="#F0F4F8"
                            Stroke="Transparent"
                            Padding="14,16"
                            MinimumHeightRequest="130">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <Label Text="&#127772;"
                                   FontSize="18"/>
                            <Label Text="UV INDEX"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   TextColor="#596065"
                                   CharacterSpacing="1"
                                   Margin="0,2,0,0"/>
                            <Label Text="11 Ext."
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#2C3338"
                                   Margin="0,10,0,0"/>
                            <Label Text="Very high risk of harm"
                                   FontSize="10"
                                   TextColor="#596065"
                                   Margin="0,6,0,0"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

           
                <VerticalStackLayout Spacing="12">
                    <Label Text="5-Day Forecast"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#2C3338"
                           Margin="4,0"/>

                    <Border BackgroundColor="White"
                            Stroke="Transparent"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="24" Opacity="0.06"/>
                        </Border.Shadow>

                        <VerticalStackLayout>
                         
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                  Padding="20,14"
                                  BackgroundColor="#F8FAFC">
                                <Label Grid.Column="0" Text="Today" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="&#9728;" FontSize="24" VerticalOptions="Center" Margin="0,0,20,0"/>
                                <Label Grid.Column="2" Text="33°" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center" Margin="0,0,16,0"/>
                                <Label Grid.Column="3" Text="26°" FontSize="15" TextColor="#596065" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#E9EEF3" Margin="20,0"/>

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="20,14">
                                <Label Grid.Column="0" Text="Tue" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="&#9925;" FontSize="24" VerticalOptions="Center" Margin="0,0,20,0"/>
                                <Label Grid.Column="2" Text="32°" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center" Margin="0,0,16,0"/>
                                <Label Grid.Column="3" Text="25°" FontSize="15" TextColor="#596065" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#E9EEF3" Margin="20,0"/>

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="20,14" BackgroundColor="#F8FAFC">
                                <Label Grid.Column="0" Text="Wed" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="&#9729;" FontSize="24" VerticalOptions="Center" Margin="0,0,20,0"/>
                                <Label Grid.Column="2" Text="31°" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center" Margin="0,0,16,0"/>
                                <Label Grid.Column="3" Text="25°" FontSize="15" TextColor="#596065" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#E9EEF3" Margin="20,0"/>

                        
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="20,14">
                                <Label Grid.Column="0" Text="Thu" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="&#127783;" FontSize="24" VerticalOptions="Center" Margin="0,0,20,0"/>
                                <Label Grid.Column="2" Text="29°" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center" Margin="0,0,16,0"/>
                                <Label Grid.Column="3" Text="24°" FontSize="15" TextColor="#596065" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#E9EEF3" Margin="20,0"/>

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="20,14" BackgroundColor="#F8FAFC">
                                <Label Grid.Column="0" Text="Fri" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="&#9925;" FontSize="24" VerticalOptions="Center" Margin="0,0,20,0"/>
                                <Label Grid.Column="2" Text="31°" FontSize="15" FontAttributes="Bold" TextColor="#2C3338" VerticalOptions="Center" Margin="0,0,16,0"/>
                                <Label Grid.Column="3" Text="25°" FontSize="15" TextColor="#596065" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border HeightRequest="200"
                        Stroke="Transparent"
                        Padding="0"
                        BackgroundColor="#D4DBE1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.08"/>
                    </Border.Shadow>
                    <Grid>
                        <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuCwylv10BVqg6Ljrf9hNgSBEbjjCk2305SqWbPEdQDFKKfJajql6pJSBLx_iHxtm_supKfL6Uu_NV0I9eQpWVGu1A0BfxRKIyP2en1KmNULdJMO1erkPONIDitSgYzN4m2gi2-VBGgzEFCeaw1smjaOIFhEEfIKlZ6NnR1ikWUgYaq-SLdlNrh2FyZc5-7dJT3DbXaOKC_8YlpBCGsLqri0OvGJHaMqxKienxgZEtEUBeWZrjRGmpKYfcKyH5lrQrwoAChcCar0b2aP"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>
                        <BoxView Color="#29667E" Opacity="0.15" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        <Border BackgroundColor="#FFFFFFDC" Stroke="Transparent" Padding="12,7" HorizontalOptions="Start" VerticalOptions="End" Margin="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="999"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="&#128506;" FontSize="13" VerticalOptions="Center"/>
                                <Label Text="PRECIPITATION MAP" FontSize="10" FontAttributes="Bold" TextColor="#2C3338" CharacterSpacing="1" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <BoxView HeightRequest="16"/>
            </VerticalStackLayout>
        </ScrollView>

       
        <Border Grid.Row="2" BackgroundColor="White" Stroke="Transparent">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-2" Radius="20" Opacity="0.06"/>
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,*,*" Padding="8,12,8,16">
                <Border Grid.Column="0" BackgroundColor="#DBEAFE" Stroke="Transparent" Padding="18,8" HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="&#9925;" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="WEATHER" FontSize="9" FontAttributes="Bold" TextColor="#003F53" CharacterSpacing="0.8" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Text="&#128205;" FontSize="22" HorizontalOptions="Center"/>
                    <Label Text="LOCATIONS" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="0.8" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Text="&#9881;" FontSize="22" HorizontalOptions="Center"/>
                    <Label Text="SETTINGS" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="0.8" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>