            Padding="30,0"
            Spacing="25">

            <Border 
                BackgroundColor="Azure"
                MinimumWidthRequest="350"
                MinimumHeightRequest="250"
                Stroke="Blue"
                Padding="10"
                HorizontalOptions="Center"
                VerticalOptions="Center">

