                        Padding="30,30"
                        Spacing="25">
                    <Label Text="Humidity"
                           FontSize="30"
                           HorizontalOptions="Center" />
                    <Label Text="69%"
                           FontSize="30"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
