<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="WeatherReport.Controls.TopAppBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border BackgroundColor="{DynamicResource Surface}"
            StrokeThickness="0"
            Stroke="Transparent">
        <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto">
            <Label Grid.Column="0"
                   Text="☰"
                   FontSize="22"
                   TextColor="{DynamicResource PrimaryDim}"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding Title, Source={x:Reference Root}}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource OnSurface}"
                   VerticalOptions="Center"
                   Margin="12,0,0,0" />
            <Label Grid.Column="2"
                   Text="🔍"
                   FontSize="20"
                   TextColor="{DynamicResource PrimaryDim}"
                   VerticalOptions="Center" />
        </Grid>
    </Border>

</ContentView>
